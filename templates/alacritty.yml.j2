# =============================================================================
# ALACRITTY CONFIGURATION
# =============================================================================
# Managed by Ansible - local changes may be overwritten
# Reference: https://alacritty.org/config-alacritty.html
# =============================================================================

# Import additional configuration files (optional)
# import:
#   - ~/.config/alacritty/themes/current.yml

# Live config reload
live_config_reload: true

# Environment variables
env:
  TERM: alacritty

# Window configuration
window:
  # Window dimensions
  dimensions:
    columns: 120
    lines: 40

  # Window padding (pixels)
  padding:
    x: 8
    y: 8

  # Spread additional padding evenly
  dynamic_padding: true

  # Window decorations
  # full: borders and title bar
  # none: neither borders nor title bar
  decorations: full

  # Startup mode
  # Windowed, Maximized, Fullscreen, SimpleFullscreen
  startup_mode: Windowed

  # Window title
  title: Alacritty

  # Allow terminal applications to change window title
  dynamic_title: true

  # Window opacity (0.0 to 1.0)
  opacity: 1.0

# Scrolling configuration
scrolling:
  # Maximum lines in scrollback buffer
  history: 10000

  # Number of lines scrolled per scroll event
  multiplier: 3

# Font configuration
font:
  # Normal font
  normal:
    family: "JetBrainsMono Nerd Font"
    style: Regular

  # Bold font
  bold:
    family: "JetBrainsMono Nerd Font"
    style: Bold

  # Italic font
  italic:
    family: "JetBrainsMono Nerd Font"
    style: Italic

  # Bold italic font
  bold_italic:
    family: "JetBrainsMono Nerd Font"
    style: Bold Italic

  # Point size
  size: 11.0

  # Offset (extra spacing)
  offset:
    x: 0
    y: 1

# Colors (Tokyo Night theme)
colors:
  # Default colors
  primary:
    background: '#1a1b26'
    foreground: '#c0caf5'

  # Normal colors
  normal:
    black:   '#15161e'
    red:     '#f7768e'
    green:   '#9ece6a'
    yellow:  '#e0af68'
    blue:    '#7aa2f7'
    magenta: '#bb9af7'
    cyan:    '#7dcfff'
    white:   '#a9b1d6'

  # Bright colors
  bright:
    black:   '#414868'
    red:     '#f7768e'
    green:   '#9ece6a'
    yellow:  '#e0af68'
    blue:    '#7aa2f7'
    magenta: '#bb9af7'
    cyan:    '#7dcfff'
    white:   '#c0caf5'

  # Selection colors
  selection:
    text: CellForeground
    background: '#283457'

# Cursor configuration
cursor:
  # Cursor style
  style:
    shape: Block
    blinking: Off

  # Vi mode cursor style
  vi_mode_style:
    shape: Block

  # Cursor blink interval (ms)
  blink_interval: 750

  # Unfocused cursor (hollow)
  unfocused_hollow: true

# Bell configuration
bell:
  animation: EaseOutExpo
  duration: 0

# Selection
selection:
  # Copy selected text to clipboard
  save_to_clipboard: true

# Mouse configuration
mouse:
  # Hide cursor when typing
  hide_when_typing: true

# Keyboard hints
hints:
  enabled:
    - regex: "(ipfs:|ipns:|magnet:|mailto:|gemini:|gopher:|https:|http:|news:|file:|git:|ssh:|ftp:)[^\u0000-\u001F\u007F-\u009F<>\"\\s{-}\\^⟨⟩`]+"
      hyperlinks: true
      command: xdg-open
      post_processing: true
      mouse:
        enabled: true
        mods: None
      binding:
        key: U
        mods: Control|Shift
